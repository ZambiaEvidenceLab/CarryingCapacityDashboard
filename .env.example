# Copy this file to .env and fill in values for your local machine.
# .env is gitignored; never commit real credentials.

# Postgres connection string used by scripts/run_dashboard.py,
# scripts/run_pipeline.py, and scripts/seed_synthetic_data.py.
CCA_DATABASE_URL=postgresql+psycopg://cca_dev:cca_dev_local_only@localhost:5432/cca_dev

# Optional overrides (defaults shown are what the scripts fall back to).
# CCA_GRID3_CACHE_PATH=scripts/.grid3_districts_cache.json
# CCA_GRID3_SIMPLIFIED_CACHE_PATH=scripts/.grid3_districts_simplified_cache.json

# Set to true to run the Dash dev server in debug mode (run_dashboard.py).
# CCA_DASHBOARD_DEBUG=false
